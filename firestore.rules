rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /airmen/{airmanId} {
      allow read, write: if true;
    }
    match /duty_rosters/{assignmentId} {
      allow read, write: if true;
    }
    match /parade_states/{logId} {
      allow read, write: if true;
    }
    match /user_profiles/{userId} {
      allow read, write: if true;
    }
    match /app_settings/{settingKey} {
      allow read, write: if true;
    }
    match /duty_ratio_matrix/{matrixId} {
      allow read, write: if true;
    }
    match /canteen_members/{memberId} {
      allow read, write: if true;
    }
    match /canteen_transactions/{transactionId} {
      allow read, write: if true;
    }
    match /canteen_expenses/{expenseId} {
      allow read, write: if true;
    }
    match /canteen_inventory/{itemId} {
      allow read, write: if true;
    }
    match /canteen_menu/{menuId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
    match /app_versions/{versionId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
